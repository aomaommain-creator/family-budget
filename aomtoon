            </div>
            <strong class="text-[#C86D51] font-heading text-xs">฿${t.amount.toLocaleString('th-TH', {minimumFractionDigits: 2})}</strong>
          `;
          list.appendChild(div);
        }
      });

      bills.forEach(b => {
        if (b.paid && !b.hasLinkedTx && b.manualPayer === personKey) {
