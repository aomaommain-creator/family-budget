<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>เงินบ้านเรา - อ้อม & ตูน</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Sarabun & Kanit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Firebase SDK -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    body {
      font-family: 'Sarabun', sans-serif;
      background-color: #F7F6F2; /* ครีมข้าวโอ๊ตอุ่น สบายตา */
      color: #26332C; /* เขียวอมเทาเข้ม อ่านง่ายและสบายตากว่าสีดำ */
      -webkit-tap-highlight-color: transparent;
    }
    .font-heading {
      font-family: 'Kanit', sans-serif;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="pb-28">

  <!-- ================= Header สีเขียวป่าสนตุ่น Forest Sage ================= -->
  <header class="bg-[#2E4A3E] text-white sticky top-0 z-30 shadow-md">
    <div class="max-w-5xl mx-auto px-4 py-2.5 flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2.5">
        <span class="text-amber-200 text-2xl">🌿</span>
        <div>
          <h1 class="text-sm md:text-base font-bold font-heading tracking-wide flex items-center gap-1.5">
            เงินบ้านเรา <span class="text-xs bg-[#3E6152] text-emerald-100 font-normal px-2 py-0.5 rounded-full">บันทึกรายวัน & ช่วยกันจ่าย</span>
          </h1>
          <p class="text-[11px] text-emerald-100/75">อ้อม & ตูน</p>
        </div>
      </div>

      <!-- เมนูแถบด้านบน โทนข้าวโอ๊ต & อบอุ่น -->
      <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-1">
        <button onclick="switchTab('daily')" id="nav-daily" class="flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-xl bg-[#E8DECE] text-[#24352D] shadow-sm transition-all whitespace-nowrap">
          <span>⚡</span> บันทึกประจำวัน
        </button>
        <button onclick="switchTab('dashboard')" id="nav-dashboard" class="flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-xl text-emerald-100 hover:bg-[#3D5E50] transition-all whitespace-nowrap">
          <span>📊</span> กระเป๋าเงิน & คุมงบ
        </button>
        <button onclick="switchTab('bills')" id="nav-bills" class="flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-xl text-emerald-100 hover:bg-[#3D5E50] transition-all whitespace-nowrap">
          <span>📋</span> บิลที่ต้องชำระ/หนี้
        </button>
        <button onclick="switchTab('accounts')" id="nav-accounts" class="flex items-center gap-1 text-xs font-medium px-3 py-1.5 rounded-xl text-emerald-100 hover:bg-[#3D5E50] transition-all whitespace-nowrap">
          <span>🏛️</span> ตั้งค่าแผนงบ & บัญชี
        </button>
      </div>
    </div>
  </header>

  <!-- ================= แถบเลือกเดือน & สถานะ Cloud ================= -->
  <div class="bg-white border-b border-[#E7E4DC] shadow-xs">
    <div class="max-w-5xl mx-auto px-4 py-2 flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold text-[#62736A]">เดือนที่ดูข้อมูล:</span>
        <select id="monthSelector" onchange="onMonthChange(this.value)" class="bg-[#F2EFE9] text-[#2E4A3E] font-bold text-xs rounded-lg px-2.5 py-1 border border-[#D5D0C5] focus:outline-none focus:ring-2 focus:ring-[#2E4A3E]">
          <!-- Populated by JS -->
        </select>
        <span id="syncBadge" class="inline-flex items-center gap-1 text-[11px] bg-[#EAF2ED] text-[#266046] px-2 py-0.5 rounded-md border border-[#C5DDCF] font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-[#266046]"></span> พร้อมใช้งาน
        </span>
      </div>

      <button onclick="toggleConfigModal()" class="text-xs text-[#3D5E50] hover:text-[#263D33] font-bold flex items-center gap-1">
        <span>⚙️</span> ซิงค์ 2 เครื่อง
      </button>
    </div>
  </div>

  <main class="max-w-5xl mx-auto p-3 md:p-5 space-y-4">

    <!-- ======================================================== -->
    <!-- แท็บ 1: บันทึกรายวันเป็นหลัก (DAILY RECORD)              -->
    <!-- ======================================================== -->
    <div id="tabContent-daily" class="space-y-4">

      <!-- กล่อง Action: ปุ่มกดบันทึกด่วน โทน Forest Sage -->
      <div class="bg-gradient-to-r from-[#2E4A3E] to-[#406655] rounded-2xl p-4 text-white shadow-sm flex flex-col sm:flex-row justify-between items-center gap-3">
        <div>
          <span class="text-xs font-medium text-[#DDE8E0] block">✨ เลือกระบุคนจ่าย บันทึกคลิกเดียวเชื่อมเข้าบิลอัตโนมัติ</span>
          <h2 class="text-base md:text-lg font-bold font-heading">ลงบันทึก รายรับ / รายจ่าย วันนี้</h2>
          <p class="text-[11px] text-emerald-100/80">จ่ายบิลไม่ถึงงบก็ถือว่าชำระแล้วได้ ระบบจะนำยอดจ่ายจริงไปหักในกระเป๋าให้อัตโนมัติ</p>
        </div>
        <button onclick="openTxModal()" class="w-full sm:w-auto px-5 py-2.5 bg-[#E8DECE] hover:bg-[#DDD1BE] text-[#26352E] font-bold font-heading text-sm rounded-xl shadow-md transition-all flex items-center justify-center gap-1.5 whitespace-nowrap">
          <span class="text-lg">➕</span> บันทึกรายการใหม่
        </button>
      </div>

      <!-- รายการบันทึกประจำวัน -->
      <div class="bg-white rounded-2xl border border-[#E7E4DC] shadow-xs overflow-hidden">
        <div class="p-3.5 md:p-4 border-b border-[#F0EDE6] flex justify-between items-center">
          <div class="flex items-center gap-2">
            <span class="text-base">📅</span>
            <h3 class="text-sm font-bold font-heading text-[#26332C]">ประวัติบันทึกประจำวัน (เรียงจากล่าสุด)</h3>
          </div>
          <span class="text-xs font-bold text-[#2E4A3E] bg-[#EBF2EE] border border-[#D0E2D7] px-2.5 py-1 rounded-lg" id="quickTxCount">
            📝 รวมบันทึก 0 รายการ
          </span>
        </div>

        <div id="dailyTxList" class="divide-y divide-[#F4F1EB]">
          <!-- Rendered by JS -->
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- แท็บ 2: แดชบอร์ดสรุปยอด & กระเป๋าเงินแยกคน               -->
    <!-- ======================================================== -->
    <div id="tabContent-dashboard" class="hidden space-y-4">

      <!-- แถบแจ้งเตือนช่วยเหลือกัน -->
      <div id="walletAlertBanner" class="hidden rounded-2xl p-3.5 text-xs flex items-center justify-between transition-all">
        <!-- Rendered by JS -->
      </div>

      <!-- การ์ดแยกกระเป๋าเงิน "ตูน 🧔" vs "อ้อม 👩" -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        
        <!-- กระเป๋าเงินตูน (โทนเขียวมิ้นต์เสจ Sage Mint) -->
        <div class="bg-white rounded-2xl border-2 border-[#8BAA9B]/50 shadow-xs p-4 space-y-3">
          <div class="flex justify-between items-center border-b border-[#F0EDE6] pb-2.5">
            <div class="flex items-center gap-2">
              <span class="w-9 h-9 rounded-xl bg-[#E8F0EC] flex items-center justify-center text-lg shadow-2xs">🧔</span>
              <div>
                <h3 class="font-bold text-sm text-[#1F332A] font-heading">กระเป๋าเงินตูน</h3>
                <span class="text-[10px] text-[#2E5443] font-semibold bg-[#E8F0EC] px-1.5 py-0.5 rounded">เงินเดือนตูน</span>
              </div>
            </div>
            <button onclick="openPersonDetailsModal('toon')" class="text-xs text-[#2E5443] bg-[#E8F0EC] hover:bg-[#D9E7E0] px-2.5 py-1 rounded-lg font-bold border border-[#BED7CA] transition-all flex items-center gap-1">
              <span>🔍</span> ดูรายการที่จ่าย
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="bg-[#F7F6F2] p-2.5 rounded-xl border border-[#E9E6DD]">
              <span class="text-[10px] text-stone-500 block">รายรับตูน (เงินเดือน)</span>
              <strong class="text-sm font-bold text-stone-800" id="walletToonIncome">฿0.00</strong>
            </div>
            <div class="bg-[#F7F6F2] p-2.5 rounded-xl border border-[#E9E6DD]">
              <span class="text-[10px] text-stone-500 block">ตูนจ่ายไปแล้วทั้งหมด</span>
              <strong class="text-sm font-bold text-[#C86D51]" id="walletToonExpense">฿0.00</strong>
            </div>
          </div>

          <div class="p-3 rounded-xl flex justify-between items-center transition-all" id="walletToonBalanceBox">
            <div>
              <span class="text-xs font-bold block" id="walletToonBalanceTitle">เงินคงเหลือในกระเป๋าตูน:</span>
              <span class="text-[10px] opacity-75" id="walletToonStatusSub">สภาพคล่องปกติ</span>
            </div>
            <strong class="text-lg font-extrabold font-heading" id="walletToonBalance">฿0.00</strong>
          </div>
        </div>

        <!-- กระเป๋าเงินอ้อม (โทนพีชอบอุ่น Warm Peach) -->
        <div class="bg-white rounded-2xl border-2 border-[#E5AA9A]/50 shadow-xs p-4 space-y-3">
          <div class="flex justify-between items-center border-b border-[#F0EDE6] pb-2.5">
            <div class="flex items-center gap-2">
              <span class="w-9 h-9 rounded-xl bg-[#FBF0EC] flex items-center justify-center text-lg shadow-2xs">👩</span>
              <div>
                <h3 class="font-bold text-sm text-[#4E2A20] font-heading">กระเป๋าเงินอ้อม</h3>
                <span class="text-[10px] text-[#A64C33] font-semibold bg-[#FBF0EC] px-1.5 py-0.5 rounded">ร้านอุทร + หวย</span>
              </div>
            </div>
            <button onclick="openPersonDetailsModal('aom')" class="text-xs text-[#A64C33] bg-[#FBF0EC] hover:bg-[#F8DFD6] px-2.5 py-1 rounded-lg font-bold border border-[#ECC1B5] transition-all flex items-center gap-1">
              <span>🔍</span> ดูรายการที่จ่าย
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs">
            <div class="bg-[#F7F6F2] p-2.5 rounded-xl border border-[#E9E6DD]">
              <span class="text-[10px] text-stone-500 block">รายรับอ้อมรวม</span>
              <strong class="text-sm font-bold text-stone-800" id="walletAomIncome">฿0.00</strong>
            </div>
            <div class="bg-[#F7F6F2] p-2.5 rounded-xl border border-[#E9E6DD]">
              <span class="text-[10px] text-stone-500 block">อ้อมจ่ายไปแล้วทั้งหมด</span>
              <strong class="text-sm font-bold text-[#C86D51]" id="walletAomExpense">฿0.00</strong>
            </div>
          </div>

          <div class="p-3 rounded-xl flex justify-between items-center transition-all" id="walletAomBalanceBox">
            <div>
              <span class="text-xs font-bold block" id="walletAomBalanceTitle">เงินคงเหลือในกระเป๋าอ้อม:</span>
              <span class="text-[10px] opacity-75" id="walletAomStatusSub">สภาพคล่องปกติ</span>
            </div>
            <strong class="text-lg font-extrabold font-heading" id="walletAomBalance">฿0.00</strong>
          </div>
        </div>

      </div>

      <!-- สรุปภาพรวมครอบครัว -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
        <div class="bg-white rounded-2xl p-3.5 border border-[#E7E4DC] shadow-xs">
          <span class="text-[11px] text-stone-400 font-medium block">รายรับรวมทั้งบ้าน</span>
          <div id="dashTotalIncome" class="text-lg font-bold font-heading text-stone-800 mt-0.5">฿0.00</div>
        </div>
        <div class="bg-white rounded-2xl p-3.5 border border-[#E7E4DC] shadow-xs">
          <span class="text-[11px] text-stone-400 font-medium block">รายจ่ายรวมที่จ่ายจริงแล้ว</span>
          <div id="dashTotalExpense" class="text-lg font-bold font-heading text-[#C86D51] mt-0.5">฿0.00</div>
        </div>
        <div class="bg-white rounded-2xl p-3.5 border border-[#E7E4DC] shadow-xs col-span-2 sm:col-span-1">
          <span class="text-[11px] text-stone-400 font-medium block">เงินคงเหลือรวม 2 คน</span>
          <div id="dashTotalNet" class="text-lg font-bold font-heading text-[#2E6B4E] mt-0.5">฿0.00</div>
        </div>
      </div>

      <!-- แดชบอร์ดติดตามงบรายวัน -->
      <div class="bg-white rounded-2xl border border-[#E7E4DC] shadow-xs p-4 md:p-5 space-y-3">
        <div class="border-b border-[#F0EDE6] pb-2 flex justify-between items-center">
          <div>
            <h3 class="text-sm font-bold font-heading text-[#26332C] flex items-center gap-1.5">
              <span>🎯</span> ติดตามงบประมาณรายจ่ายผันแปร
            </h3>
            <p class="text-[11px] text-stone-400">เปรียบเทียบงบประมาณตั้งต้น vs ยอดรวมที่ใช้จริง</p>
          </div>
        </div>

        <div id="budgetTrackerContainer" class="space-y-3 pt-1">
          <!-- Rendered by JS -->
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- แท็บ 3: บิลที่ต้องชำระ/หนี้                              -->
    <!-- ======================================================== -->
    <div id="tabContent-bills" class="space-y-4 hidden">
      
      <div class="bg-white rounded-2xl border border-[#E7E4DC] shadow-xs overflow-hidden">
        <div class="p-4 border-b border-[#F0EDE6] flex flex-wrap justify-between items-center gap-2">
          <div>
            <h3 class="text-sm font-bold font-heading text-[#26332C] flex items-center gap-1.5">
              <span>📋</span> ตารางบิลที่ต้องชำระ & หนี้สิน
            </h3>
            <p class="text-[11px] text-stone-400">แสดงคู่กัน: <strong>ยอดงบ</strong> และ <strong>ยอดชำระจริง</strong> (จัดการเพิ่ม/ลดบิลได้ที่แท็บตั้งค่าแผนงบ)</p>
          </div>
          <span class="text-xs font-bold text-[#2E4A3E] bg-[#EBF2EE] border border-[#CFE1D6] px-2.5 py-1 rounded-lg" id="fixedBillsTotalBadge">
            งบรวม: ฿0
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-stone-700">
            <thead class="bg-[#F8F7F3] text-stone-500 font-bold border-b border-[#E7E4DC]">
              <tr>
                <th class="py-2.5 px-3 text-center w-20">กำหนดจ่าย</th>
                <th class="py-2.5 px-3">รายการ</th>
                <th class="py-2.5 px-3 text-center w-28">ผู้จ่ายบิลนี้</th>
                <th class="py-2.5 px-3 text-right">ยอดงบ</th>
                <th class="py-2.5 px-3 text-right">ยอดชำระจริง</th>
                <th class="py-2.5 px-3 text-center w-36">สถานะการชำระ</th>
              </tr>
            </thead>
            <tbody id="fixedBillsTableBody" class="divide-y divide-[#F4F1EB]">
              <!-- Filled by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- สรุปหนี้สินระยะยาวอ้อม -->
      <div class="bg-white rounded-2xl p-4 border border-[#E7E4DC] shadow-xs space-y-3">
        <h4 class="text-xs font-bold font-heading text-[#26332C] flex items-center gap-1.5">
          <span>💳</span> รายละเอียดหนี้สินระยะยาว (ภาระของอ้อม)
        </h4>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 text-xs">
          <div class="bg-[#F9F8F5] p-3 rounded-xl border border-[#E7E4DC]">
            <div class="flex justify-between font-bold text-stone-800">
              <span>📱 ผ่อนโทรศัพท์อ้อม</span>
              <span class="text-[#2E6B4E] font-semibold">งวด 7/36</span>
            </div>
            <div class="text-stone-500 mt-1">1,600 บ./ด. (เหลือ ~46,400 บ.)</div>
            <span class="text-[10px] text-[#2E6B4E] block mt-1">ครบ 36 งวด ย้ายเข้าเงินฉุกเฉิน</span>
          </div>

          <div class="bg-[#F9F8F5] p-3 rounded-xl border border-[#E7E4DC]">
            <div class="flex justify-between font-bold text-stone-800">
              <span>🏦 สินเชื่อ BK</span>
              <span class="text-[#B56728] font-semibold">~60 เดือน</span>
            </div>
            <div class="text-stone-500 mt-1">1,000 บ./ด. (ยอดประมาณการ ~60,000 บ.)</div>
          </div>

          <div class="bg-[#F9F8F5] p-3 rounded-xl border border-[#E7E4DC]">
            <div class="flex justify-between font-bold text-stone-800">
              <span>👵 คืนเงินแม่</span>
              <span class="text-[#2E4A3E] font-semibold">~39 เดือน</span>
            </div>
            <div class="text-stone-500 mt-1">5,000 บ./ด. (ยอดประมาณการ ~195,000 บ.)</div>
          </div>
        </div>
      </div>

    </div>

    <!-- ======================================================== -->
    <!-- แท็บ 4: ตั้งค่าแผนงบประมาณ & บัญชี (MASTER PLAN MANAGER)  -->
    <!-- ======================================================== -->
    <div id="tabContent-accounts" class="hidden space-y-4">
      
      <!-- ส่วนนำ: อธิบายฟังก์ชัน -->
      <div class="bg-gradient-to-r from-[#2E4A3E] to-[#3B5D4D] text-white rounded-2xl p-4 shadow-sm flex justify-between items-center">
        <div>
          <h3 class="text-base font-bold font-heading flex items-center gap-1.5">
            <span>⚙️</span> ศูนย์กลางตั้งค่าแผนงบประมาณ & ค่าใช้จ่าย
          </h3>
          <p class="text-xs text-emerald-100/90 mt-0.5">
            ปรับเปลี่ยนตัวเลข เพิ่มหรือลดหมวดหมู่ที่นี่ ระบบจะเชื่อมโยงไปที่ <strong>บันทึกรายวัน, แดชบอร์ดคุมงบ, และตารางบิล</strong> อัตโนมัติ
          </p>
        </div>
      </div>

      <!-- 1. จัดการหมวดหมู่งบประมาณรายจ่ายผันแปร -->
      <div class="bg-white rounded-2xl p-4 md:p-5 border border-[#E7E4DC] shadow-xs space-y-3">
        <div class="flex justify-between items-center border-b border-[#F0EDE6] pb-2.5">
          <div>
            <h4 class="text-sm font-bold font-heading text-[#26332C] flex items-center gap-1.5">
              <span>🎯</span> 1. หมวดงบประมาณรายจ่ายผันแปร (ใช้บันทึกรายวัน & ติดตามงบ)
            </h4>
            <p class="text-[11px] text-stone-400">เพิ่มค่าอาหารแมว ค่าน้ำมัน หรือปรับงบประมาณประจำเดือนได้ที่นี่</p>
          </div>
          <button onclick="promptAddNewVariableBudget()" class="px-3 py-1.5 bg-[#2E6B4E] hover:bg-[#25573F] text-white font-bold text-xs rounded-xl shadow-xs flex items-center gap-1">
