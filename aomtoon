    function renderAll() {
      ensureData(currentYM);
      const cur = localData[currentYM];
      const txs = cur.transactions || [];
      const bills = cur.fixedBills || [];
      const vBudgets = cur.variableBudgets || getDefaultVariableBudgets();

      const txList = document.getElementById('dailyTxList');
      txList.innerHTML = '';

      let toonIncome = 0;
      let aomIncome = 0;
      let toonTotalExpense = 0;
      let aomTotalExpense = 0;

      const categoryExpenseTotals = {};
      const billPaymentTracker = {};

      txs.forEach(t => {
        const isToon = t.payer === 'toon';

        if (t.type === 'income') {
          if (isToon) toonIncome += t.amount;
          else aomIncome += t.amount;
        } else {
          if (isToon) toonTotalExpense += t.amount;
          else aomTotalExpense += t.amount;

          categoryExpenseTotals[t.categoryId] = (categoryExpenseTotals[t.categoryId] || 0) + t.amount;

          if (t.linkedBillId) {
            if (!billPaymentTracker[t.linkedBillId]) {
              billPaymentTracker[t.linkedBillId] = { toonPaid: 0, aomPaid: 0, lastDate: t.date };
            }
            if (isToon) billPaymentTracker[t.linkedBillId].toonPaid += t.amount;
            else billPaymentTracker[t.linkedBillId].aomPaid += t.amount;
            billPaymentTracker[t.linkedBillId].lastDate = t.date;
          }
        }
      });

      document.getElementById('quickTxCount').innerText = `📝 รวมบันทึก ${txs.length} รายการ`;

      if (txs.length === 0) {
        txList.innerHTML = `
          <div class="text-center py-8 text-stone-400 text-xs">
            ✨ ยังไม่มีรายการบันทึกของเดือนนี้ กดปุ่ม "+ บันทึกรายการใหม่" ด้านบนได้เลย!
          </div>
        `;
      } else {
        txs.forEach(t => {
          const isInc = t.type === 'income';
          const isToon = t.payer === 'toon';

          const div = document.createElement('div');
          div.className = 'p-3 flex items-center justify-between hover:bg-[#F9F8F5] transition-all';
          div.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-xl flex items-center justify-center text-sm ${isInc ? 'bg-emerald-100 text-emerald-800' : 'bg-[#FBF0EC] text-[#C86D51]'}">
                ${t.icon || (isInc ? '💰' : '💸')}
              </span>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-xs text-stone-800">${t.categoryName}</span>
                  <span class="text-[9px] font-bold px-1.5 py-0.2 rounded-full ${isToon ? 'bg-[#E8F0EC] text-[#1F332A]' : 'bg-[#FBF0EC] text-[#4E2A20]'}">
                    ${isToon ? '🧔 ตูน' : '👩 อ้อม'}
                  </span>
                  ${t.linkedBillId ? '<span class="text-[9px] font-bold bg-[#FAF3EC] text-[#2E4A3E] border border-[#DDD3C5] px-1 rounded">🔗 บิล</span>' : ''}
                </div>
                <div class="text-[10px] text-stone-400 flex items-center gap-2 mt-0.5">
                  <span>🗓️ ${t.date}</span>
                  ${t.note ? `<span class="text-[#2E4A3E] font-medium">• ${t.note}</span>` : ''}
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-bold font-heading text-xs md:text-sm ${isInc ? 'text-emerald-700' : 'text-[#C86D51]'}">
                ${isInc ? '+' : '-'}฿${t.amount.toLocaleString('th-TH', {minimumFractionDigits: 2})}
              </span>
              <button onclick="deleteTransaction('${t.id}')" class="text-stone-300 hover:text-rose-500 text-xs p-1" title="ลบรายการ">✕</button>
            </div>
          `;
          txList.appendChild(div);
        });
      }

      // 2. คำนวณตารางบิลที่ต้องชำระ
      let fixedBudgetTotal = 0;
      const billsTable = document.getElementById('fixedBillsTableBody');
      billsTable.innerHTML = '';

      bills.forEach(b => {
        fixedBudgetTotal += b.amount;

        const tracker = billPaymentTracker[b.id];
        let toonPaid = 0;
        let aomPaid = 0;
        let totalPaidOnBill = 0;
        let lastPaidDate = b.paidDate;

        if (tracker) {
          toonPaid = tracker.toonPaid;
          aomPaid = tracker.aomPaid;
          totalPaidOnBill = toonPaid + aomPaid;
          lastPaidDate = tracker.lastDate;
          b.hasLinkedTx = true;
        } else {
          b.hasLinkedTx = false;
          if (b.paid) {
            totalPaidOnBill = b.actualAmount > 0 ? b.actualAmount : b.amount;
            if (b.manualPayer === 'aom') aomPaid = totalPaidOnBill;
            else toonPaid = totalPaidOnBill;

            if (b.manualPayer === 'aom') aomTotalExpense += totalPaidOnBill;
            else toonTotalExpense += totalPaidOnBill;
          }
        }

        let payerBadgeHtml = '';
        let paymentBreakdownText = '';

        if (totalPaidOnBill > 0) {
          if (toonPaid > 0 && aomPaid > 0) {
            payerBadgeHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#E8DECE] text-[#3E3125] border border-[#D5C9B5]">🤝 ช่วยกันออก</span>`;
            paymentBreakdownText = `<span class="text-[9px] text-[#2E4A3E] block mt-0.5 font-medium">(อ้อม ฿${aomPaid.toLocaleString()} + ตูน ฿${toonPaid.toLocaleString()})</span>`;
          } else if (toonPaid > 0) {
            payerBadgeHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#E8F0EC] text-[#1F332A] border border-[#BED7CA]">🧔 ตูนชำระ</span>`;
          } else if (aomPaid > 0) {
            payerBadgeHtml = `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-[#FBF0EC] text-[#4E2A20] border border-[#ECC1B5]">👩 อ้อมชำระ</span>`;
          }
        } else {
          payerBadgeHtml = `<span class="text-stone-400 font-bold text-sm">-</span>`;
        }

        let statusButtonHtml = '';
        let actualAmountColumnHtml = '';

        if (totalPaidOnBill > 0) {
          let dateStr = '';
          if (lastPaidDate) {
            const parts = lastPaidDate.split('-');
            dateStr = `(${parseInt(parts[2])} ${['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'][parseInt(parts[1])-1]})`;
          }

          const diff = b.amount - totalPaidOnBill;
          let diffBadge = '';
          if (diff > 0) {
            diffBadge = `<span class="text-[9px] text-[#2E6B4E] font-semibold block">ประหยัด ฿${diff.toLocaleString()}</span>`;
          } else if (diff < 0) {
            diffBadge = `<span class="text-[9px] text-[#C86D51] font-semibold block">เกินงบ ฿${Math.abs(diff).toLocaleString()}</span>`;
          }

          statusButtonHtml = `
            <button onclick="openBillPayModal('${b.id}')" class="px-2 py-1 rounded-md text-[10px] font-bold bg-[#EAF2ED] text-[#266046] border border-[#C5DDCF] hover:bg-[#D8E9DF] transition-all">
              ✓ ชำระแล้ว ${dateStr}
            </button>
          `;

          actualAmountColumnHtml = `
            <div class="text-right">
              <span class="font-bold text-[#2E6B4E] text-xs">฿${totalPaidOnBill.toLocaleString('th-TH', {minimumFractionDigits: 2})}</span>
              ${diffBadge}
            </div>
          `;
        } else {
          statusButtonHtml = `
            <button onclick="openBillPayModal('${b.id}')" class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-[#F7F6F2] text-stone-600 border border-[#D5D0C5] hover:bg-[#EAE7E0] transition-all">
              ⏳ รอชำระ
            </button>
          `;
          actualAmountColumnHtml = `<span class="text-stone-400 text-center block">-</span>`;
        }

        const isFullyPaid = totalPaidOnBill > 0;
        const tr = document.createElement('tr');
        tr.className = `hover:bg-[#F9F8F5] ${isFullyPaid ? 'bg-white/80' : 'bg-white'}`;
        tr.innerHTML = `
          <td class="py-2.5 px-3 text-center">
            <span class="bg-[#F2EFE9] text-[#26332C] font-bold px-1.5 py-0.5 rounded text-[10px] border border-[#D5D0C5]">
              ทุกวันที่ ${b.dueDate}
            </span>
          </td>
          <td class="py-2.5 px-3">
            <div class="font-semibold text-stone-800 ${isFullyPaid ? 'line-through text-stone-400' : ''}">${b.title}</div>
            ${b.note ? `<span class="text-[9px] text-[#2E4A3E] font-medium">${b.note}</span>` : ''}
            ${paymentBreakdownText}
          </td>
          <td class="py-2.5 px-3 text-center">
            ${payerBadgeHtml}
          </td>
          <td class="py-2.5 px-3 text-right font-medium text-stone-500">
            ฿${b.amount.toLocaleString('th-TH', {minimumFractionDigits: 2})}
          </td>
          <td class="py-2.5 px-3">
            ${actualAmountColumnHtml}
          </td>
          <td class="py-2.5 px-3 text-center">
            ${statusButtonHtml}
          </td>
        `;
        billsTable.appendChild(tr);
      });

      document.getElementById('fixedBillsTotalBadge').innerText = `งบรวม: ฿${fixedBudgetTotal.toLocaleString('th-TH')}`;

      // 3. แดชบอร์ดติดตามงบรายวัน (Variable Budgets Tracker)
      const trackerContainer = document.getElementById('budgetTrackerContainer');
      trackerContainer.innerHTML = '';

      vBudgets.forEach(cfg => {
        const actualSpent = categoryExpenseTotals[cfg.id] || 0;
        const diff = cfg.budget - actualSpent;
        const percent = cfg.budget > 0 ? Math.min(100, (actualSpent / cfg.budget) * 100) : 0;

        let statusText = '';
        let barColor = 'bg-[#2E6B4E]';

        if (cfg.budget > 0) {
          if (diff >= 0) {
            statusText = `<span class="text-[#2E6B4E] font-medium">เหลืองบ ฿${diff.toLocaleString('th-TH')}</span>`;
          } else {
            statusText = `<span class="text-[#C86D51] font-bold">⚠️ เกินงบ ฿${Math.abs(diff).toLocaleString('th-TH')}</span>`;
            barColor = 'bg-[#C86D51]';
          }
        }

        const div = document.createElement('div');
        div.className = 'bg-[#F9F8F5] p-3 rounded-xl border border-[#E7E4DC] space-y-1.5';
        div.innerHTML = `
          <div class="flex justify-between items-center text-xs">
            <span class="font-bold text-stone-800 flex items-center gap-1.5">
              <span>${cfg.icon || '🛒'}</span> ${cfg.name}
            </span>
            <div class="text-right">
              <span class="font-bold text-stone-900">ใช้จริง ฿${actualSpent.toLocaleString('th-TH')}</span>
              ${cfg.budget > 0 ? `<span class="text-stone-400 text-[10px]"> / งบ ฿${cfg.budget.toLocaleString('th-TH')}</span>` : ''}
            </div>
          </div>

          ${cfg.budget > 0 ? `
            <div class="w-full bg-[#E5E0D5] rounded-full h-1.5 overflow-hidden">
              <div class="${barColor} h-full rounded-full transition-all" style="width: ${percent}%"></div>
            </div>
            <div class="flex justify-between text-[10px]">
              <span class="text-stone-400">ใช้ไปแล้ว ${percent.toFixed(0)}%</span>
              ${statusText}
            </div>
          ` : ''}
        `;
        trackerContainer.appendChild(div);
      });

      // 4. สรุปแยกกระเป๋า (ตูน vs อ้อม)
      const toonBalance = toonIncome - toonTotalExpense;
      const aomBalance = aomIncome - aomTotalExpense;

      // กระเป๋าตูน
      document.getElementById('walletToonIncome').innerText = `฿${toonIncome.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('walletToonExpense').innerText = `฿${toonTotalExpense.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('walletToonBalance').innerText = `${toonBalance >= 0 ? '+' : '-'}฿${Math.abs(toonBalance).toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      
      const toonBox = document.getElementById('walletToonBalanceBox');
      const toonSub = document.getElementById('walletToonStatusSub');
      if (toonBalance >= 0) {
        toonBox.className = 'p-3 rounded-xl flex justify-between items-center bg-[#E8F0EC] text-[#1F332A] border border-[#BED7CA]';
        toonSub.innerText = 'มีเงินเหลือพร้อมหมุนเวียน';
      } else {
        toonBox.className = 'p-3 rounded-xl flex justify-between items-center bg-[#FBF0EC] text-[#4E2A20] border border-[#ECC1B5]';
        toonSub.innerText = '⚠️ เงินหมด/ติดลบ ให้อ้อมช่วยจ่าย';
      }

      // กระเป๋าอ้อม
      document.getElementById('walletAomIncome').innerText = `฿${aomIncome.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('walletAomExpense').innerText = `฿${aomTotalExpense.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('walletAomBalance').innerText = `${aomBalance >= 0 ? '+' : '-'}฿${Math.abs(aomBalance).toLocaleString('th-TH', {minimumFractionDigits: 2})}`;

      const aomBox = document.getElementById('walletAomBalanceBox');
      const aomSub = document.getElementById('walletAomStatusSub');
      if (aomBalance >= 0) {
        aomBox.className = 'p-3 rounded-xl flex justify-between items-center bg-[#FBF0EC] text-[#4E2A20] border border-[#ECC1B5]';
        aomSub.innerText = 'มีเงินเหลือพร้อมหมุนเวียน';
      } else {
        aomBox.className = 'p-3 rounded-xl flex justify-between items-center bg-[#FBF0EC] text-[#4E2A20] border border-[#ECC1B5]';
        aomSub.innerText = '⚠️ เงินหมด/ติดลบ ให้ตูนช่วยจ่าย';
      }

      // แถบแจ้งเตือนช่วยเหลือกัน
      const alertBanner = document.getElementById('walletAlertBanner');
      if (toonBalance < 0 && aomBalance >= 0) {
        alertBanner.classList.remove('hidden');
        alertBanner.className = 'rounded-2xl p-3.5 text-xs flex items-center justify-between bg-[#FBF0EC] border border-[#ECC1B5] text-[#A64C33] shadow-2xs';
        alertBanner.innerHTML = `
          <span>🧔 <strong>เงินตูนหมดแล้ว:</strong> อ้อมช่วยรับช่วงจ่ายบิลที่เหลือแทนนะ</span>
          <button onclick="switchTab('bills')" class="px-2.5 py-1 bg-[#E8DECE] text-[#24352D] font-bold rounded-lg text-[11px] hover:bg-[#DDD1BE]">ไปดูบิลที่ค้าง</button>
        `;
      } else if (aomBalance < 0 && toonBalance >= 0) {
        alertBanner.classList.remove('hidden');
        alertBanner.className = 'rounded-2xl p-3.5 text-xs flex items-center justify-between bg-[#FBF0EC] border border-[#ECC1B5] text-[#A64C33] shadow-2xs';
        alertBanner.innerHTML = `
          <span>👩 <strong>เงินอ้อมหมดแล้ว:</strong> ตูนช่วยรับช่วงจ่ายบิลที่เหลือแทนนะ</span>
          <button onclick="switchTab('bills')" class="px-2.5 py-1 bg-[#E8DECE] text-[#24352D] font-bold rounded-lg text-[11px] hover:bg-[#DDD1BE]">ไปดูบิลที่ค้าง</button>
        `;
      } else {
        alertBanner.classList.add('hidden');
      }

      // ยอดรวมทั้งบ้าน
      const grandIncome = toonIncome + aomIncome;
      const grandExpense = toonTotalExpense + aomTotalExpense;
      const grandNet = grandIncome - grandExpense;

      document.getElementById('dashTotalIncome').innerText = `฿${grandIncome.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('dashTotalExpense').innerText = `฿${grandExpense.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
      document.getElementById('dashTotalNet').innerText = `${grandNet >= 0 ? '+' : '-'}฿${Math.abs(grandNet).toLocaleString('th-TH', {minimumFractionDigits: 2})}`;

      // เรนเดอร์หน้าตั้งค่าแผนงบประมาณ (Tab 4)
      renderMasterPlanSettings();
    }

    function toggleConfigModal() {
      document.getElementById('configModal').classList.toggle('hidden');
    }

    function saveFirebaseConfig() {
      const url = document.getElementById('firebaseUrlInput').value.trim();
      if (url) {
        localStorage.setItem('family_budget_fb_url', url);
        initFirebase(url);
        toggleConfigModal();
      }
    }

    function initFirebase(databaseURL) {
      try {
        if (!firebase.apps.length) {
          firebase.initializeApp({ databaseURL: databaseURL });
        }
        dbRef = firebase.database().ref('family_budget_sage_oat');

        dbRef.on('value', (snapshot) => {
          const val = snapshot.val();
          if (val) {
            localData = val;
            localStorage.setItem('family_budget_sage_oat_v1', JSON.stringify(localData));
            renderAll();
          }
        });

        document.getElementById('syncBadge').className = 'inline-flex items-center gap-1 text-[11px] bg-[#EAF2ED] text-[#266046] px-2 py-0.5 rounded-md border border-[#C5DDCF] font-medium';
        document.getElementById('syncBadge').innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-[#266046]"></span> ซิงค์ 2 เครื่อง';
      } catch (err) {
        console.error(err);
      }
    }

    window.onload = () => {
      initMonthSelector();
      ensureData(currentYM);
      renderAll();

      const savedUrl = localStorage.getItem('family_budget_fb_url');
      if (savedUrl) {
        document.getElementById('firebaseUrlInput').value = savedUrl;
        initFirebase(savedUrl);
      }
    };
  </script>
</body>
</html>
