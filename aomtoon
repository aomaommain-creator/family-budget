    function populateCategoriesAndBillsDropdown() {
      const catSelect = document.getElementById('txCategory');
      catSelect.innerHTML = '';

      if (currentTxType === 'expense') {
        const optgroupBills = document.createElement('optgroup');
        optgroupBills.label = '📋 บิลประจำงวด (เชื่อมโยงหน้าบิลอัตโนมัติ)';

        const bills = localData[currentYM]?.fixedBills || [];
        bills.forEach(b => {
          const opt = document.createElement('option');
          opt.value = 'BILL:' + b.id;
          opt.innerText = `🔗 ${b.title} (งบ ฿${b.amount.toLocaleString()})`;
          opt.dataset.amount = b.amount;
          opt.dataset.title = b.title;
          optgroupBills.appendChild(opt);
        });
        catSelect.appendChild(optgroupBills);

        const optgroupDaily = document.createElement('optgroup');
        optgroupDaily.label = '🛒 ค่าใช้จ่ายทั่วไปรายวัน (ตามแผน)';

        const vBudgets = localData[currentYM]?.variableBudgets || getDefaultVariableBudgets();
        vBudgets.forEach(c => {
          const opt = document.createElement('option');
          opt.value = 'CAT:' + c.id;
          opt.innerText = `${c.icon || '🛒'} ${c.name} ${c.budget > 0 ? `(งบ ฿${c.budget.toLocaleString()})` : ''}`;
          opt.dataset.title = c.name;
          optgroupDaily.appendChild(opt);
        });
        catSelect.appendChild(optgroupDaily);

        catSelect.onchange = (e) => {
          const val = e.target.value;
          const selectedOption = e.target.selectedOptions[0];
          if (val.startsWith('BILL:')) {
            const amount = selectedOption.dataset.amount;
            if (amount) {
              document.getElementById('txAmount').value = amount;
              document.getElementById('txNote').value = `จ่ายบิล: ${selectedOption.dataset.title}`;
            }
          } else {
            if (document.getElementById('txNote').value.startsWith('จ่ายบิล:')) {
              document.getElementById('txNote').value = '';
            }
          }
        };

      } else {
        incomeCategoryConfigs.forEach(c => {
          const opt = document.createElement('option');
          opt.value = 'INC:' + c.id;
          opt.innerText = `${c.icon} ${c.name}`;
          opt.dataset.title = c.name;
          catSelect.appendChild(opt);
        });
        catSelect.onchange = null;
      }
    }

