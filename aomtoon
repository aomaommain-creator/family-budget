      currentYM = ym;
      ensureData(currentYM);
      renderAll();
    }

    function ensureData(ym) {
      if (!localData[ym]) {
        localData[ym] = {
          transactions: [],
          variableBudgets: getDefaultVariableBudgets(),
          fixedBills: getDefaultFixedBills(ym)
        };
      }
      if (!localData[ym].transactions) localData[ym].transactions = [];
      if (!localData[ym].variableBudgets) localData[ym].variableBudgets = getDefaultVariableBudgets();
      if (!localData[ym].fixedBills) localData[ym].fixedBills = getDefaultFixedBills(ym);
    }

